{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Chart 8, categorical choropleth. Each state and territory is coloured by whether pet rabbits are allowed, with the rule and its government source in the tooltip.",

  "width": "container",
  "height": 440,

  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-132, 0],
    "center": [0, -27]
  },

  "layer": [
    {
      "description": "States, joined to the legal-status table on the state code.",
      "data": {
        "url": "data/geo/australia-states.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {"url": "data/legal/rabbit-legal-status.csv"},
            "key": "state",
            "fields": ["status", "rule", "source_url"]
          }
        },
        {
          "calculate": "datum.source_url ? datum.source_url : 'Not yet checked'",
          "as": "source"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#f3f5f1", "strokeWidth": 1.5},
      "encoding": {
        "color": {
          "field": "status",
          "type": "nominal",
          "scale": {
            "domain": ["Allowed", "Allowed with extra rules", "Banned"],
            "range": ["#4a64b0", "#97a8d8", "#c0662b"]
          },
          "legend": {"title": null}
        },
        "tooltip": [
          {"field": "properties.name", "title": "Where"},
          {"field": "status", "title": "Pet rabbits"},
          {"field": "rule", "title": "Rule"},
          {"field": "source", "title": "Source"}
        ]
      }
    },
    {
      "description": "State codes as direct labels, so the map reads without the legend. The ACT is too small to hold its label, so it sits out to sea in dark text.",
      "data": {
        "url": "data/geo/state-centroids.csv",
        "format": {"parse": {"lon": "number", "lat": "number"}}
      },
      "transform": [
        {"calculate": "datum.state === 'ACT' ? datum.lon + 2.8 : datum.lon", "as": "label_lon"}
      ],
      "mark": {"type": "text", "fontSize": 13, "fontWeight": 600},
      "encoding": {
        "longitude": {"field": "label_lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "state"},
        "color": {
          "condition": {"test": "datum.state === 'ACT'", "value": "#1e2b2a"},
          "value": "#ffffff"
        }
      }
    }
  ]
}
