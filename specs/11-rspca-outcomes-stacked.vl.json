{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Chart 11, 100% stacked bar chart. What happened to the small pets (the RSPCA's 'other animals', which include rabbits) taken in by each state's RSPCA in 2023-24, the latest year whose outcome figures add up. States are sorted by the share rehomed.",

  "data": {
    "url": "data/rspca/other-animals-by-state.csv",
    "format": {"parse": {"received": "number", "reclaimed": "number", "returned": "number", "rehomed": "number", "in_care": "number", "transferred": "number", "euthanased": "number", "other": "number"}}
  },

  "transform": [
    {"filter": "datum.financial_year === '2023-24' && datum.received >= 50"},
    {"calculate": "datum.reclaimed + (datum.returned || 0)", "as": "back_home"},
    {"calculate": "datum.rehomed / datum.received", "as": "share_rehomed"},
    {"calculate": "datum.state + '  (' + format(datum.received, ',') + ')'", "as": "label"},
    {"fold": ["rehomed", "back_home", "transferred", "in_care", "euthanased", "other"], "as": ["outcome_key", "animals"]},
    {
      "calculate": "{'rehomed': 'New home', 'back_home': 'Back to owner', 'transferred': 'Transferred', 'in_care': 'Still in care', 'euthanased': 'Euthanased', 'other': 'Other (incl. died)'}[datum.outcome_key]",
      "as": "outcome"
    },
    {
      "calculate": "indexof(['New home', 'Back to owner', 'Transferred', 'Still in care', 'Euthanased', 'Other (incl. died)'], datum.outcome)",
      "as": "outcome_order"
    },
    {"calculate": "datum.animals / datum.received", "as": "share"}
  ],

  "width": "container",
  "height": {"step": 34},

  "mark": {"type": "bar", "stroke": "#f3f5f1", "strokeWidth": 2},

  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": {"field": "share_rehomed", "op": "max", "order": "descending"},
      "axis": {"title": null, "domain": false, "ticks": false, "labelFontSize": 13}
    },
    "x": {
      "field": "animals",
      "type": "quantitative",
      "stack": "normalize",
      "axis": {"title": null, "format": ".0%", "values": [0, 0.25, 0.5, 0.75, 1], "domain": false, "ticks": false, "grid": false, "orient": "top"}
    },
    "color": {
      "field": "outcome",
      "type": "nominal",
      "scale": {
        "domain": ["New home", "Back to owner", "Transferred", "Still in care", "Euthanased", "Other (incl. died)"],
        "range": ["#4a64b0", "#00806a", "#b3820f", "#a3aea8", "#a3478f", "#6b8e23"]
      },
      "legend": {"title": null, "orient": "top", "direction": "horizontal", "columns": 6}
    },
    "order": {"field": "outcome_order"},
    "tooltip": [
      {"field": "state", "title": "RSPCA"},
      {"field": "outcome", "title": "Outcome"},
      {"field": "animals", "title": "Animals", "format": ","},
      {"field": "share", "title": "Share", "format": ".0%"}
    ]
  }
}
