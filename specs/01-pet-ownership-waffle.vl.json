{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Chart 1, small-multiple picture waffles. Each grid is 100 Australian households: a pale house is a household without that kind of pet, and the animal icon is one with it. A faded last icon is part of a household (e.g. 0.5). Rabbits aren't shown here because the next chart covers them.",

  "data": {"url": "data/ama/pets-in-australia-2025.csv"},

  "transform": [
    {"filter": "datum.year == 2025 && datum.breakdown === 'households_by_pet' && datum.category !== 'Other'"},
    {"calculate": "toNumber(datum.value)", "as": "per_100"},
    {"calculate": "{'Dogs': 'dog', 'Cats': 'cat', 'Fish': 'fish', 'Birds': 'bird', 'Small mammals': 'small_mammal', 'Reptiles': 'reptile'}[datum.category]", "as": "animal_icon"},
    {"calculate": "datum.category + '  ' + datum.per_100 + '%'", "as": "panel"},
    {"calculate": "sequence(0, 100)", "as": "slot"},
    {"flatten": ["slot"]},
    {"calculate": "datum.slot % 10", "as": "col"},
    {"calculate": "floor(datum.slot / 10)", "as": "row"},
    {"calculate": "clamp(datum.per_100 - datum.slot, 0, 1)", "as": "fill"},
    {"calculate": "datum.fill > 0 ? datum.animal_icon : 'house'", "as": "icon"},
    {"lookup": "icon", "from": {"data": {"url": "data/icons.json"}, "key": "name", "fields": ["path"]}}
  ],

  "facet": {
    "field": "panel",
    "type": "nominal",
    "sort": {"field": "per_100", "op": "max", "order": "descending"},
    "header": {"title": null, "labelAnchor": "start", "labelFontSize": 14, "labelFontWeight": 600, "labelPadding": 6}
  },
  "columns": 6,
  "spacing": {"column": 20, "row": 16},

  "spec": {
    "width": {"step": 17},
    "height": {"step": 17},
    "mark": {"type": "point", "filled": true, "size": 215, "strokeWidth": 0},
    "encoding": {
      "x": {"field": "col", "type": "ordinal", "axis": null},
      "y": {"field": "row", "type": "ordinal", "axis": null},
      "shape": {"field": "path", "type": "nominal", "scale": null},
      "color": {"condition": {"test": "datum.fill > 0", "value": "#4a64b0"}, "value": "#cfd6cd"},
      "opacity": {"condition": {"test": "datum.fill > 0", "field": "fill", "type": "quantitative", "scale": {"domain": [0, 1], "range": [0.35, 1]}, "legend": null}, "value": 1},
      "tooltip": [
        {"field": "category", "title": "Pet"},
        {"field": "per_100", "title": "Households in 100"}
      ]
    }
  }
}
