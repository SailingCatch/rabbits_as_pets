{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Chart 8a, dot plot with one arrow. Why Australians keep small mammals such as rabbits (share of small-mammal owners giving each reason, 2025). Mental health also has a 2022 figure, so an arrow shows how much it rose. Owners could give more than one reason.",

  "data": {"url": "data/ama/pets-in-australia-2025.csv"},

  "transform": [
    {"filter": "datum.breakdown === 'small_mammal_reason'"},
    {"calculate": "toNumber(datum.value) / 100", "as": "share"},
    {"calculate": "toNumber(datum.year)", "as": "year"}
  ],

  "width": "container",
  "height": {"step": 44},

  "encoding": {
    "y": {
      "field": "category",
      "type": "nominal",
      "sort": ["Companionship", "Hobby", "Relaxation", "Mental health"],
      "axis": {"title": null, "labelFontSize": 13, "labelColor": "#1e2b2a"}
    }
  },

  "layer": [
    {
      "description": "Arrow from 2022 to 2025 for mental health.",
      "transform": [
        {"filter": "datum.category === 'Mental health'"},
        {"pivot": "year", "value": "share", "groupby": ["category"]}
      ],
      "layer": [
        {
          "mark": {"type": "rule", "color": "#9aa9c9", "strokeWidth": 3},
          "encoding": {"x": {"field": "2022", "type": "quantitative"}, "x2": {"field": "2025"}}
        },
        {
          "mark": {"type": "point", "shape": "triangle-right", "size": 120, "filled": true, "color": "#9aa9c9", "xOffset": -9},
          "encoding": {"x": {"field": "2025", "type": "quantitative"}}
        },
        {
          "mark": {"type": "text", "align": "right", "dx": -10, "fontSize": 12, "color": "#5b6b66", "text": "8% in 2022"},
          "encoding": {"x": {"field": "2022", "type": "quantitative"}}
        }
      ]
    },
    {
      "description": "2025 values: one dot each, value written beside it.",
      "transform": [{"filter": "datum.year === 2025"}],
      "layer": [
        {
          "mark": {"type": "circle", "size": 170, "opacity": 1, "color": "#4a64b0"},
          "encoding": {
            "x": {
              "field": "share",
              "type": "quantitative",
              "scale": {"domain": [0, 0.4]},
              "axis": {"title": "Share of small-mammal owners, 2025", "format": ".0%", "values": [0, 0.1, 0.2, 0.3, 0.4], "orient": "top", "titleAnchor": "start", "titleAlign": "left"}
            },
            "tooltip": [
              {"field": "category", "title": "Reason"},
              {"field": "share", "title": "Owners giving it (2025)", "format": ".0%"}
            ]
          }
        },
        {
          "mark": {"type": "text", "align": "left", "dx": 12, "fontSize": 13, "fontWeight": 700, "color": "#1e2b2a"},
          "encoding": {"x": {"field": "share", "type": "quantitative"}, "text": {"field": "share", "format": ".0%"}}
        }
      ]
    }
  ]
}
