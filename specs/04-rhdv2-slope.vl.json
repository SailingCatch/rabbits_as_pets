{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Chart 4, slope chart. Wild rabbits counted per kilometre of spotlight survey at six monitoring sites, before and after the RHDV2 virus arrived. Every line falls. The scale is logarithmic (each step up multiplies), so an equal percentage drop looks equally steep and the low values don't overlap.",

  "data": {"url": "data/ramsey/rhdv2-site-abundance.csv"},

  "transform": [
    {"fold": ["before", "after"], "as": ["when", "per_km"]},
    {"calculate": "toNumber(datum.per_km)", "as": "per_km"},
    {"calculate": "datum.when === 'before' ? 'Before RHDV2' : 'After RHDV2'", "as": "period"},
    {"calculate": "datum.site + ' (' + datum.state + ')'", "as": "where"},
    {"calculate": "format(toNumber(datum.change), '.0%')", "as": "change_label"}
  ],

  "width": 520,
  "height": 460,

  "encoding": {
    "x": {
      "field": "period",
      "type": "ordinal",
      "sort": ["Before RHDV2", "After RHDV2"],
      "scale": {"padding": 0.9},
      "axis": {"title": null, "orient": "top", "labelAngle": 0, "labelFontSize": 13, "labelFontWeight": 600, "domain": false, "ticks": false}
    },
    "y": {
      "field": "per_km",
      "type": "quantitative",
      "scale": {"type": "log", "domain": [5, 150]},
      "axis": {"title": "Rabbits per km of survey", "values": [5, 10, 20, 50, 100, 150], "domain": false, "ticks": false}
    },
    "detail": {"field": "site"}
  },

  "layer": [
    {
      "mark": {"type": "line", "color": "#c0662b", "strokeWidth": 2},
      "encoding": {"tooltip": [{"field": "where", "title": "Site"}, {"field": "change_label", "title": "Change"}]}
    },
    {
      "mark": {"type": "circle", "color": "#c0662b", "size": 70, "opacity": 1, "stroke": "#f3f5f1", "strokeWidth": 2},
      "encoding": {
        "tooltip": [
          {"field": "where", "title": "Site"},
          {"field": "period", "title": "When"},
          {"field": "per_km", "title": "Rabbits per km"}
        ]
      }
    },
    {
      "description": "Value on the left of each line.",
      "transform": [{"filter": "datum.when === 'before'"}],
      "mark": {"type": "text", "align": "right", "dx": -10, "fontSize": 12, "color": "#5b6b66"},
      "encoding": {"text": {"field": "per_km", "format": ".0f"}}
    },
    {
      "description": "Site name and the drop on the right of each line.",
      "transform": [
        {"filter": "datum.when === 'after'"},
        {"calculate": "datum.where + '  ' + datum.change_label", "as": "label"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 12, "color": "#1e2b2a"},
      "encoding": {"text": {"field": "label"}}
    }
  ]
}
