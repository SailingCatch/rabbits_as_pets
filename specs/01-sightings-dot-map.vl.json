{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Chart 1, dot map. One dot per wild rabbit sighting reported to the Atlas of Living Australia in the chosen year, drawn over the state outlines.",

  "width": "container",
  "height": 480,

  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-132, 0],
    "center": [0, -27]
  },

  "params": [
    {
      "name": "year",
      "value": 2025,
      "bind": {"input": "radio", "options": [2024, 2025], "name": "Year "}
    }
  ],

  "layer": [
    {
      "description": "Base map: land in a quiet fill so the dots stand out.",
      "data": {
        "url": "data/geo/australia-states.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "mark": {"type": "geoshape", "fill": "#e3e8e1", "stroke": "#f3f5f1", "strokeWidth": 1.5}
    },
    {
      "description": "Sightings: small, semi-transparent dots so dense areas build up darker.",
      "data": {
        "url": "data/ala/sightings-points.csv",
        "format": {"parse": {"lat": "number", "lon": "number", "year": "number"}}
      },
      "transform": [{"filter": "datum.year === year"}],
      "mark": {"type": "circle", "size": 6, "opacity": 0.35, "color": "#c0662b"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    }
  ]
}
