{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Chart 1b, pictogram (Isotype style). 65 houses, one of which has a rabbit: about 1 in 65 Australian households keeps one. Worked out from the AMA survey: 3% of households own small mammals and 51% of those keep rabbits (1.53 in 100, or about 1 in 65).",

  "data": {"sequence": {"start": 0, "stop": 65, "as": "i"}},

  "transform": [
    {"calculate": "datum.i % 13", "as": "col"},
    {"calculate": "floor(datum.i / 13)", "as": "row"},
    {"calculate": "datum.i === 32", "as": "has_rabbit"},
    {"calculate": "datum.has_rabbit ? 'pet_rabbit' : 'house'", "as": "icon"},
    {"lookup": "icon", "from": {"data": {"url": "data/icons.json"}, "key": "name", "fields": ["path"]}}
  ],

  "width": {"step": 36},
  "height": {"step": 38},

  "mark": {"type": "point", "filled": true, "opacity": 1, "strokeWidth": 0},

  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null},
    "shape": {"field": "path", "type": "nominal", "scale": null},
    "size": {"condition": {"test": "datum.has_rabbit", "value": 1100}, "value": 600},
    "color": {"condition": {"test": "datum.has_rabbit", "value": "#4a64b0"}, "value": "#cfd6cd"}
  }
}
