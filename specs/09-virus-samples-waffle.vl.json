{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Chart 9, waffle chart. 100 squares stand for the 2,777 dead rabbits and hares sent to CSIRO for virus testing (2015-2022), coloured by where the animal came from. Half were pets.",

  "data": {"url": "data/peng/lagovirus-samples.csv"},

  "transform": [
    {"filter": "datum.breakdown === 'source'"},
    {"calculate": "toNumber(datum.samples)", "as": "samples"},
    {
      "calculate": "{'Pet (domestic) rabbits': 1, 'Wild rabbits': 2, 'Unknown': 3, 'Hares': 4}[datum.category]",
      "as": "order"
    },
    {"calculate": "{'Pet (domestic) rabbits': 'Pet rabbits', 'Wild rabbits': 'Wild rabbits', 'Unknown': 'Not recorded (probably wild)', 'Hares': 'Hares'}[datum.category]", "as": "group"},
    {"joinaggregate": [{"op": "sum", "field": "samples", "as": "total"}]},
    {
      "window": [{"op": "sum", "field": "samples", "as": "running"}],
      "sort": [{"field": "order"}],
      "frame": [null, 0]
    },
    {"calculate": "(datum.running - datum.samples) / datum.total * 100", "as": "start"},
    {"calculate": "datum.running / datum.total * 100", "as": "end"},
    {"calculate": "datum.samples / datum.total", "as": "share"},
    {
      "description": "Give each group the squares from its rounded start to its rounded end, so the 100 squares are shared out exactly.",
      "calculate": "sequence(round(datum.start), round(datum.end))", "as": "square"
    },
    {"flatten": ["square"]},
    {"calculate": "datum.square % 20", "as": "col"},
    {"calculate": "floor(datum.square / 20)", "as": "row"}
  ],

  "width": {"step": 30},
  "height": {"step": 30},

  "mark": {"type": "square", "size": 640, "opacity": 1, "cornerRadius": 2},

  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null},
    "color": {
      "field": "group",
      "type": "nominal",
      "sort": ["Pet rabbits", "Wild rabbits", "Not recorded (probably wild)", "Hares"],
      "scale": {
        "domain": ["Pet rabbits", "Wild rabbits", "Not recorded (probably wild)", "Hares"],
        "range": ["#4a64b0", "#c0662b", "#a3aea8", "#a3478f"]
      },
      "legend": {"title": "Each square is 1% of samples", "orient": "right", "direction": "vertical", "labelFontSize": 13, "symbolSize": 160, "symbolType": "square"}
    },
    "tooltip": [
      {"field": "group", "title": "Animal"},
      {"field": "samples", "title": "Samples", "format": ","},
      {"field": "share", "title": "Share", "format": ".0%"}
    ]
  }
}
